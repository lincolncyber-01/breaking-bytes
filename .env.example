# Catálogo de variáveis; forneça valores pelo ambiente/provedor de segredos.
# Não versione nem grave valores reais neste arquivo. Senhas dos papéis: hex 32–128.
POSTGRES_PASSWORD=
# Runtime: postgres://stories_runtime:SENHA@postgres:5432/stories
DATABASE_URL=
# Migrações: postgres://stories_owner:OUTRA_SENHA@postgres:5432/stories
MIGRATION_DATABASE_URL=
# Administrador, somente durante --provision-database, nunca entregue ao app.
BOOTSTRAP_DATABASE_URL=
MIGRATION_DATABASE_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
BACKUP_DATABASE_PASSWORD=
# Pelo menos 32 bytes aleatórios; nunca use em query string.
ADMIN_TOKEN=
# Necessários somente com os estágios correspondentes habilitados.
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_INSPECTION_TOKEN=
FB_PAGE_ID=
# Instagram Login: recibo JSON vinculado ao hash, conforme docs/tokens.md.
IG_TOKEN_RECEIPT=
LLM_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Credenciais exclusivas do bucket privado de backups.
BACKUP_DATABASE_URL=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Restauração: outro cluster, banco vazio com sufixo _restore_check.
RESTORE_DATABASE_URL=
RESTORE_DATABASE_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GRAFANA_ADMIN_PASSWORD=
# Valores não secretos opcionais.
ADMIN_DOMAIN=
STORIES_IMAGE=
BACKUP_IMAGE=
# Pull privado do GHCR: somente leitura; helper não grava o token no config Docker.
GITHUB_ACTOR=
GHCR_READ_TOKEN=
# O helper tools/docker_registry.py usa GITHUB_TOKEN no processo de pull/release.
GITHUB_TOKEN=
# Staging usa projeto, credenciais, bucket e conta de teste separados.
STAGING_POSTGRES_PASSWORD=
STAGING_DATABASE_URL=
STAGING_MIGRATION_DATABASE_URL=
STAGING_BOOTSTRAP_DATABASE_URL=
STAGING_MIGRATION_DATABASE_PASSWORD=
STAGING_RUNTIME_DATABASE_PASSWORD=
STAGING_BACKUP_DATABASE_PASSWORD=
STAGING_ADMIN_TOKEN=
STAGING_IG_USER_ID=
STAGING_IG_ACCESS_TOKEN=
STAGING_META_INSPECTION_TOKEN=
STAGING_FB_PAGE_ID=
STAGING_IG_TOKEN_RECEIPT=
STAGING_R2_ACCOUNT_ID=
STAGING_R2_ACCESS_KEY_ID=
STAGING_R2_SECRET_ACCESS_KEY=
STAGING_R2_BUCKET=
STAGING_ALERTS_ENABLED=

# Copie para .env e preencha localmente. Nunca versione valores reais.
# Gere senhas em hexadecimal para evitar escapes no DSN.
POSTGRES_PASSWORD=
# Compose: postgres://stories:SENHA@postgres:5432/stories
# Binário no host: use 127.0.0.1 e a porta publicada do Postgres.
DATABASE_URL=
# Gere pelo menos 32 bytes aleatórios.
ADMIN_TOKEN=
# Instagram continua opcional em dry_run. LLM_API_KEY é obrigatória se llm.enabled=true.
IG_USER_ID=
IG_ACCESS_TOKEN=
LLM_API_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Identificador Cloudflare de 32 dígitos hexadecimais, necessário no modo real.
R2_ACCOUNT_ID=
